{
  "name": "business-travel-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "NODE_ENV=development node --watch server/index.js",
    "client:dev": "cd client && npm run dev",
    "install:all": "npm install && cd client && npm install",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "db:push": "drizzle-kit push",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.66.0",
    "@neondatabase/serverless": "^1.0.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.0",
    "express": "^5.1.0",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "resend": "^6.4.0",
    "twilio": "^5.10.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.5"
  }
}
