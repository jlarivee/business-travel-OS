# Required for persistent Replit storage.
DATABASE_URL=

# Required before publishing publicly. APP_PASSWORD can reuse your existing Replit Secret.
APP_USERNAME=
APP_PASSWORD=
JWT_SECRET=

# Required for live AI chat/tool use.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_EXTRACTION_MODEL=claude-3-5-haiku-20241022

# Required for live fare research. Without this, the app uses demo fare leads.
TAVILY_API_KEY=

# Optional v2/fallback secrets. Leave blank for v1.
FIRECRAWL_API_KEY=

# Optional Gmail alerts. Use a Google app password, not your normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Business Travel OS
NOTIFY_EMAIL_TO=

# Optional alternate email/SMS/Slack providers.
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFY_SMS_TO=
SLACK_WEBHOOK_URL=

# Optional runtime config.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000
PORT=3000
